import java.util.Scanner;

public class Calificaciones {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        float suma = 0.0f;
        int contadorExcelente = 0;
        int contadorAprobado = 0;
        int contadorSupletorio = 0;
        int contadorReprobado = 0;

        for (int i = 1; i <= 5; i++) {
            float nota;

            System.out.print("Ingrese la calificacion " + i + " (0-10): ");
            nota = sc.nextFloat();

            if (nota < 0 || nota > 10) {
                System.out.println("Nota invalida. Debe estar entre 0 y 10.");
                i--;
                continue;
            }

            suma += nota;

            if (nota >= 9) {
                System.out.println("Excelente");
                contadorExcelente++;
            } else if (nota >= 7) {
                System.out.println("Aprobado");
                contadorAprobado++;
            } else if (nota >= 5) {
                System.out.println("Supletorio");
                contadorSupletorio++;
            } else {
                System.out.println("Reprobado");
                contadorReprobado++;
            }
        }

        float promedio = suma / 5;

        System.out.println("\n--- Resultados ---");
        System.out.printf("Promedio: %.2f%n", promedio);
        System.out.println("Excelentes:  " + contadorExcelente);
        System.out.println("Aprobados:   " + contadorAprobado);
        System.out.println("Supletorios: " + contadorSupletorio);
        System.out.println("Reprobados:  " + contadorReprobado);

        sc.close();
    }
}
