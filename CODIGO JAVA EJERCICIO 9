import java.util.Scanner;

public class FacturacionCafeteria {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int opcion;
        double subtotal = 0;

        do {
            System.out.println("1. Cafe ($1,50)");
            System.out.println("2. Sandwich ($2,50)");
            System.out.println("3. Jugo ($1,75)");
            System.out.println("4. Ensalada ($3)");
            System.out.println("5. Finalizar");
            System.out.print("Seleccione una opcion: ");
            opcion = sc.nextInt();

            double precio = 0;
            boolean valido = true;

            switch (opcion) {
                case 1:
                    precio = 1.50;
                    break;
                case 2:
                    precio = 2.50;
                    break;
                case 3:
                    precio = 1.75;
                    break;
                case 4:
                    precio = 3;
                    break;
                case 5:
                    System.out.println("Finalizando compra...");
                    valido = false;
                    break;
                default:
                    System.out.println("Opcion invalida.");
                    valido = false;
            }

            if (valido && opcion != 5) {
                System.out.print("Ingrese la cantidad: ");
                int cantidad = sc.nextInt();

                if (cantidad <= 0) {
                    System.out.println("Cantidad invalida.");
                } else {
                    subtotal = subtotal + (precio * cantidad);
                    System.out.println("Subtotal acumulado: $" + subtotal);
                }
            }

        } while (opcion != 5);

        double descuento;
        if (subtotal < 10) {
            descuento = 0;
        } else if (subtotal < 20) {
            descuento = 0.05;
        } else if (subtotal < 50) {
            descuento = 0.10;
        } else {
            descuento = 0.15;
        }

        double total = subtotal - (subtotal * descuento);

        System.out.println("Subtotal: $" + subtotal);
        System.out.println("Descuento aplicado: " + (descuento * 100) + "%");
        System.out.println("Total a pagar: $" + total);

        sc.close();
    }
}
