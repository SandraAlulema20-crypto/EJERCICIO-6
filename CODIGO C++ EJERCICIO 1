#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    float suma = 0.0f;
    int contadorExcelente = 0;
    int contadorAprobado = 0;
    int contadorSupletorio = 0;
    int contadorReprobado = 0;

    for (int i = 1; i <= 5; i++) {
        float nota;

        cout << "Ingrese la calificacion " << i << " (0-10): ";
        cin >> nota;

        if (nota < 0 || nota > 10) {
            cout << "Nota invalida. Debe estar entre 0 y 10.\n";
            i--;
            continue;
        }

        suma += nota;

        if (nota >= 9) {
            cout << "Excelente\n";
            contadorExcelente++;
        } else if (nota >= 7) {
            cout << "Aprobado\n";
            contadorAprobado++;
        } else if (nota >= 5) {
            cout << "Supletorio\n";
            contadorSupletorio++;
        } else {
            cout << "Reprobado\n";
            contadorReprobado++;
        }
    }

    float promedio = suma / 5;

    cout << fixed << setprecision(2);
    cout << "\n--- Resultados ---\n";
    cout << "Promedio: " << promedio << "\n";
    cout << "Excelentes:  " << contadorExcelente << "\n";
    cout << "Aprobados:   " << contadorAprobado << "\n";
    cout << "Supletorios: " << contadorSupletorio << "\n";
    cout << "Reprobados:  " << contadorReprobado << "\n";

    return 0;
}
