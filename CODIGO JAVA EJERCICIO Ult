import java.util.Scanner;

public class SistemaAcademico {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int maxEstudiantes = 50;
        String[] nombres = new String[maxEstudiantes];
        double[] promedios = new double[maxEstudiantes];
        double[] asistencias = new double[maxEstudiantes];
        String[] clasificaciones = new String[maxEstudiantes];
        int total = 0;

        int opcion;

        do {
            System.out.println("1. Registrar estudiante");
            System.out.println("2. Mostrar resultados");
            System.out.println("3. Buscar estudiante");
            System.out.println("4. Salir");
            System.out.print("Seleccione una opcion: ");
            opcion = sc.nextInt();
            sc.nextLine();

            switch (opcion) {
                case 1:
                    if (total >= maxEstudiantes) {
                        System.out.println("No hay espacio para mas estudiantes.");
                        break;
                    }

                    System.out.print("Ingrese el nombre del estudiante: ");
                    String nombre = sc.nextLine();

                    double sumaCalif = 0;
                    boolean calificacionesValidas = true;

                    for (int i = 1; i <= 3; i++) {
                        System.out.print("Ingrese calificacion " + i + ": ");
                        double calif = sc.nextDouble();

                        if (calif < 0 || calif > 10) {
                            System.out.println("Calificacion fuera de rango.");
                            calificacionesValidas = false;
                        }

                        sumaCalif = sumaCalif + calif;
                    }

                    System.out.print("Ingrese el porcentaje de asistencia: ");
                    double asistencia = sc.nextDouble();
                    sc.nextLine();

                    if (asistencia < 0 || asistencia > 100) {
                        System.out.println("Asistencia invalida.");
                        break;
                    }

                    if (!calificacionesValidas) {
                        break;
                    }

                    double promedio = sumaCalif / 3;
                    String clasificacion;

                    if (promedio >= 9 && asistencia >= 90) {
                        clasificacion = "Excelente";
                    } else if (promedio >= 7 && asistencia >= 70) {
                        clasificacion = "Aprobado";
                    } else if (promedio >= 5 && asistencia >= 70) {
                        clasificacion = "Supletorio";
                    } else {
                        clasificacion = "Reprobado";
                    }

                    nombres[total] = nombre;
                    promedios[total] = promedio;
                    asistencias[total] = asistencia;
                    clasificaciones[total] = clasificacion;
                    total++;

                    System.out.println("Estudiante registrado. Promedio: " + promedio + " - Clasificacion: " + clasificacion);
                    break;

                case 2:
                    if (total == 0) {
                        System.out.println("No hay estudiantes registrados.");
                    } else {
                        for (int i = 0; i < total; i++) {
                            System.out.println(nombres[i] + " - Promedio: " + promedios[i] + " - Asistencia: " + asistencias[i] + "% - " + clasificaciones[i]);
                        }
                    }
                    break;

                case 3:
                    if (total == 0) {
                        System.out.println("No hay estudiantes registrados.");
                        break;
                    }

                    System.out.print("Ingrese el nombre a buscar: ");
                    String buscado = sc.nextLine();

                    int indice = 0;
                    boolean encontrado = false;

                    while (indice < total && !encontrado) {
                        if (nombres[indice].equalsIgnoreCase(buscado)) {
                            encontrado = true;
                        } else {
                            indice++;
                        }
                    }

                    if (encontrado) {
                        System.out.println(nombres[indice] + " - Promedio: " + promedios[indice] + " - Asistencia: " + asistencias[indice] + "% - " + clasificaciones[indice]);
                    } else {
                        System.out.println("Estudiante no encontrado.");
                    }
                    break;

                case 4:
                    System.out.println("Saliendo...");
                    break;

                default:
                    System.out.println("Opcion invalida.");
            }

        } while (opcion != 4);

        sc.close();
    }
}
