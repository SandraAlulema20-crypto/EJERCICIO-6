import java.util.Scanner;

public class Estacionamiento {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int opcionMenu;
        float recaudacionTotal = 0.0f;

        do {
            System.out.println("\n===== ESTACIONAMIENTO UNIVERSITARIO =====");
            System.out.println("1. Calcular tarifa");
            System.out.println("2. Ver tarifas");
            System.out.println("3. Mostrar recaudacion");
            System.out.println("4. Salir");
            System.out.print("Seleccione una opcion: ");
            opcionMenu = sc.nextInt();

            switch (opcionMenu) {

                case 1: {
                    char registrarOtro;

                    do {
                        int tipoVehiculo, horas;
                        char rol, boletoPerdido;
                        float tarifaHora = 0.0f, descuento, recargo;
                        float subtotal, total;

                        System.out.println("\n--- Tipo de vehiculo ---");
                        System.out.println("1. Motocicleta ($0.50/h)");
                        System.out.println("2. Automovil   ($1.00/h)");
                        System.out.println("3. Camioneta   ($1.50/h)");
                        System.out.print("Seleccione: ");
                        tipoVehiculo = sc.nextInt();

                        switch (tipoVehiculo) {
                            case 1: tarifaHora = 0.50f; break;
                            case 2: tarifaHora = 1.00f; break;
                            case 3: tarifaHora = 1.50f; break;
                            default:
                                System.out.println("Tipo de vehiculo invalido. Se asume automovil.");
                                tarifaHora = 1.00f;
                                break;
                        }

                        do {
                            System.out.print("Ingrese las horas de estacionamiento (1-24): ");
                            horas = sc.nextInt();
                            if (horas < 1 || horas > 24) {
                                System.out.println("Horas invalidas. Debe estar entre 1 y 24.");
                            }
                        } while (horas < 1 || horas > 24);

                        System.out.print("Ingrese rol (E = estudiante, D = docente, O = otro): ");
                        rol = sc.next().charAt(0);

                        subtotal = horas * tarifaHora;

                        if (rol == 'E' || rol == 'e') {
                            descuento = subtotal * 0.20f;
                            System.out.println("Descuento de estudiante (20%) aplicado.");
                        } else if (rol == 'D' || rol == 'd') {
                            descuento = subtotal * 0.10f;
                            System.out.println("Descuento de docente (10%) aplicado.");
                        } else {
                            descuento = 0.0f;
                            System.out.println("Sin descuento aplicable.");
                        }

                        System.out.print("Perdio el boleto? (S/N): ");
                        boletoPerdido = sc.next().charAt(0);

                        if (boletoPerdido == 'S' || boletoPerdido == 's') {
                            recargo = 5.0f;
                            System.out.println("Se aplica recargo de $5 por boleto perdido.");
                        } else {
                            recargo = 0.0f;
                        }

                        total = subtotal - descuento + recargo;
                        recaudacionTotal += total;

                        System.out.println("\n--- Resumen ---");
                        System.out.printf("Subtotal:   $%.2f%n", subtotal);
                        System.out.printf("Descuento: -$%.2f%n", descuento);
                        System.out.printf("Recargo:   +$%.2f%n", recargo);
                        System.out.printf("TOTAL A PAGAR: $%.2f%n", total);

                        System.out.print("\nDesea registrar otro vehiculo? (S/N): ");
                        registrarOtro = sc.next().charAt(0);

                    } while (registrarOtro == 'S' || registrarOtro == 's');

                    break;
                }

                case 2:
                    System.out.println("\n--- Tarifas por hora ---");
                    System.out.println("Motocicleta: $0.50");
                    System.out.println("Automovil:   $1.00");
                    System.out.println("Camioneta:   $1.50");
                    System.out.println("Descuentos: Estudiante 20%, Docente 10%");
                    System.out.println("Recargo por boleto perdido: $5.00");
                    break;

                case 3:
                    System.out.printf("%nRecaudacion total del dia: $%.2f%n", recaudacionTotal);
                    break;

                case 4:
                    System.out.printf("%nSaliendo del sistema. Recaudacion final: $%.2f%n", recaudacionTotal);
                    break;

                default:
                    System.out.println("\nOpcion invalida. Intente de nuevo.");
                    break;
            }

        } while (opcionMenu != 4);

        sc.close();
    }
}
