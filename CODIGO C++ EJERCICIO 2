#include <iostream>
using namespace std;

int main() {
    int opcion;

    do {
        int numero;
        cout << "Ingrese un numero entre 1 y 12: ";
        cin >> numero;

        if (numero < 1 || numero > 12) {
            cout << "Numero invalido." << endl;
            continue;
        }

        cout << "1. Tabla ascendente" << endl;
        cout << "2. Tabla descendente" << endl;
        cout << "3. Salir" << endl;
        cout << "Seleccione una opcion: ";
        cin >> opcion;

        switch (opcion) {
            case 1:
                for (int i = 1; i <= 10; i++) {
                    cout << numero << " x " << i << " = " << (numero * i) << endl;
                }
                break;
            case 2:
                for (int i = 10; i >= 1; i--) {
                    cout << numero << " x " << i << " = " << (numero * i) << endl;
                }
                break;
            case 3:
                cout << "Saliendo..." << endl;
                break;
            default:
                cout << "Opcion invalida." << endl;
        }

    } while (opcion != 3);

    return 0;
}
